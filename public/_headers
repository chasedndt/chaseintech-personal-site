# Security headers for every route (Cloudflare Pages).
#
# CSP notes:
# - 'unsafe-inline' script/style is required by Astro's inlined component
#   scripts and scoped styles. Cloudflare Web Analytics is the only allowed
#   third-party script and network endpoint.
# - 'wasm-unsafe-eval' is required by Pagefind's WebAssembly search index.
# - img-src allows YouTube thumbnails (i.ytimg.com) for the video feed.
# - frame-src allows the privacy-enhanced YouTube embed domain only.
# - form-action allows the first-party site and the Buttondown subscribe endpoint.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://i.ytimg.com data:; media-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://buttondown.com; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/images/*
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=86400
/pagefind/*
  Cache-Control: public, max-age=86400
