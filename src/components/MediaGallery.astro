---
// Media strip for a project (screenshots, diagrams, demo clips).
//
// Deliberately calm: a fixed 16:9 aspect grid that caps at three tiles per row
// so a project page never turns into a congested wall of thumbnails. When no
// media is supplied it renders a single quiet reserved slot instead of
// disappearing — it reads as "coming", not as a broken layout.
//
// Media shape:
// { src: "/images/projects/<slug>/shot-1.webp", alt: "...", caption: "..." }
// or { type: "video", src: "...", poster: "...", alt: "..." }
//
// Nothing is cropped by default: assets are shown whole inside the tile.
// Pass fit: "cover" for an asset that genuinely reads as a background and is
// safe to crop. Pass wide: true for artwork that needs the full row —
// diagrams and very wide strips lose their detail at a third of a row.
interface Props {
  media?: Array<{
    src: string;
    alt: string;
    caption?: string;
    type?: string;
    fit?: "cover" | "contain";
    wide?: boolean;
  }>;
  label?: string;
}
const { media = [], label = "Media" } = Astro.props;
---

<section class="media">
  <h2>{label}</h2>

  {
    media.length > 0 ? (
      <ul class="grid">
        {media.map((item) => (
          <li class={item.wide ? "wide" : undefined}>
            <figure>
              <div class="frame">
                {item.type === "video" ? (
                  <video
                    src={item.src}
                    poster={item.poster}
                    controls
                    preload="none"
                    class={item.fit === "cover" ? "fit-cover" : undefined}
                  />
                ) : (
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    class={item.fit === "cover" ? "fit-cover" : undefined}
                  />
                )}
              </div>
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    ) : (
      <div class="reserved">
        <div class="frame frame--empty">
          <span class="mark" aria-hidden="true"></span>
        </div>
        <p>
          Screenshots and demo clips for this project will appear here once
          they're added.
        </p>
      </div>
    )
  }
</section>

<style>
  .media h2 {
    font-size: 0.78rem;
    font-family: var(--cit-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cit-accent-teal);
    margin-bottom: 0.9rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
  }
  figure {
    margin: 0;
  }
  .frame {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    overflow: hidden;
    background: var(--cit-bg-surface);
    display: grid;
    place-items: center;
  }
  /* Never crop by default.
     The tile is a fixed 16:9 for layout calm, but real assets are not: app
     screenshots run 16:10, panel details are near-square, and timeline strips
     are extremely wide. Filling the tile silently discarded a lot of them —
     measured at 10% for a typical screenshot and up to 69% for a wide strip,
     which is not a crop, it is a different image. `contain` letterboxes
     instead, so what ships is what was captured. Opt back in per item with
     fit: "cover" when an asset genuinely is a background. */
  .frame img,
  .frame video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 0.4rem;
  }
  .frame img.fit-cover,
  .frame video.fit-cover {
    object-fit: cover;
    padding: 0;
  }
  /* Wide artwork (diagrams, timeline strips) gets the full row rather than a
     third of one, so detail inside it stays legible. */
  .grid > li.wide {
    grid-column: 1 / -1;
  }
  .grid > li.wide .frame {
    aspect-ratio: auto;
  }
  .grid > li.wide .frame img {
    height: auto;
    max-height: 30rem;
  }
  figcaption {
    margin-top: 0.55rem;
    font-size: 0.78rem;
    color: var(--cit-text-muted);
  }

  /* Quiet reserved slot — one tile, half width, never a grid of empty boxes */
  .reserved {
    display: grid;
    gap: 0.75rem;
    max-width: 420px;
  }
  .frame--empty {
    border-style: dashed;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.015) 25%,
      transparent 25% 50%,
      rgba(255, 255, 255, 0.015) 50% 75%,
      transparent 75%
    );
    background-size: 14px 14px;
  }
  .mark {
    width: 22px;
    height: 22px;
    border: 1px solid var(--cit-border-strong);
    border-radius: 4px;
    opacity: 0.7;
  }
  .reserved p {
    font-size: 0.8rem;
    color: var(--cit-text-muted);
  }
</style>
