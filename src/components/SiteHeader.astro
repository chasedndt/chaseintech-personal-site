---
import { site, nav, moreNav } from "../data/site.js";

const path = Astro.url.pathname;
const isCurrent = (href) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true"></span>
      {site.brand}
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="more">
          <!-- details/summary: keyboard-accessible dropdown with no JS needed -->
          <details data-more-menu>
            <summary aria-label="More pages">
              More <span class="caret" aria-hidden="true">▾</span>
            </summary>
            <ul class="more-panel">
              {
                moreNav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Primary" hidden data-mobile-nav>
    <ul>
      {
        [...nav, ...moreNav].map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.querySelector("[data-mobile-nav]");

  // Translucent → solid on scroll, without hiding the hero (§12.1)
  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 40);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Close the More dropdown on outside click or Escape.
  const moreMenu = document.querySelector("[data-more-menu]");
  document.addEventListener("click", (event) => {
    if (moreMenu?.open && !moreMenu.contains(event.target)) moreMenu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && moreMenu?.open) moreMenu.open = false;
  });

  const setOpen = (open) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
    header?.classList.toggle("menu-open", open);
    if (open) {
      panel.querySelector("a")?.focus();
    }
  };

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // Close on Escape, and return focus to the trigger (§12.2)
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });

  panel?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled,
  .site-header.menu-open {
    background: rgba(7, 16, 20, 0.86);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--cit-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 66px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--cit-accent-teal);
    box-shadow: 0 0 12px var(--cit-accent-teal);
  }

  .desktop-nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--cit-text-secondary);
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
  }
  .desktop-nav a:hover {
    color: var(--cit-text-primary);
  }
  /* Current route marked by more than colour alone (§12.3) */
  .desktop-nav a[aria-current="page"] {
    color: var(--cit-accent-teal);
    border-bottom-color: var(--cit-accent-teal);
  }

  /* "More" dropdown */
  .more details {
    position: relative;
  }
  .more summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--cit-text-secondary);
    padding: 0.35rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    user-select: none;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary:hover {
    color: var(--cit-text-primary);
  }
  .caret {
    font-size: 0.65rem;
    transition: transform 0.15s ease;
  }
  .more details[open] .caret {
    transform: rotate(180deg);
  }
  .more details[open] summary {
    color: var(--cit-accent-teal);
  }
  .more-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    min-width: 160px;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    display: grid;
    gap: 0.1rem;
    background: var(--cit-bg-surface);
    border: 1px solid var(--cit-border-strong);
    border-radius: var(--cit-radius);
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.85);
    z-index: 60;
  }
  .more-panel a {
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: var(--cit-radius-sm);
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--cit-text-secondary);
  }
  .more-panel a:hover {
    background: rgba(57, 222, 201, 0.08);
    color: var(--cit-text-primary);
  }
  .more-panel a[aria-current="page"] {
    color: var(--cit-accent-teal);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius-sm);
    color: var(--cit-text-primary);
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 5px;
  }
  .bars span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.1rem 1.2rem;
    display: grid;
    gap: 0.15rem;
  }
  .mobile-nav a {
    display: block;
    padding: 0.85rem 0.25rem;
    text-decoration: none;
    color: var(--cit-text-secondary);
    border-bottom: 1px solid var(--cit-border);
  }
  .mobile-nav a[aria-current="page"] {
    color: var(--cit-accent-teal);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
</style>
