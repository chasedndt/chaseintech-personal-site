---
import PixelMark from "./PixelMark.astro";

// Personal identity marker (§17). Uses the vector redraw of the pixel PFP.
// To use the original raster export instead, drop it at
// `public/images/avatar.png` and set AVATAR_SRC.
const AVATAR_SRC = null;

interface Props {
  size?: number;
  ring?: boolean;
}
const { size = 84, ring = true } = Astro.props;
---

<div
  class:list={["avatar", ring && "avatar--ring"]}
  style={`--avatar-size:${size}px`}
>
  {
    AVATAR_SRC ? (
      <img src={AVATAR_SRC} alt="ChaseInTech avatar" width={size} height={size} />
    ) : (
      <PixelMark />
    )
  }
</div>

<style>
  .avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--cit-bg-elevated);
    display: grid;
    place-items: center;
  }
  .avatar--ring {
    box-shadow:
      0 0 0 1px var(--cit-border-strong),
      0 0 0 4px rgba(57, 222, 201, 0.12);
  }
  .avatar :global(svg),
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
