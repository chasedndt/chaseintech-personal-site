---
// Personal identity marker (§17).
// Uses the operator's actual profile image, unmodified.
interface Props {
  size?: number;
  ring?: boolean;
  alt?: string;
}
const { size = 84, ring = true, alt = "ChaseInTech" } = Astro.props;
---

<div
  class:list={["avatar", ring && "avatar--ring"]}
  style={`--avatar-size:${size}px`}
>
  <img src="/images/pfp-pixel.png" alt={alt} width={size} height={size} />
</div>

<style>
  .avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--cit-bg-elevated);
  }
  .avatar--ring {
    box-shadow:
      0 0 0 1px var(--cit-border-strong),
      0 0 0 4px rgba(57, 222, 201, 0.12);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    /* Keep the pixel art crisp instead of smoothing it. */
    image-rendering: pixelated;
  }
</style>
