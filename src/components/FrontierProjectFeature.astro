---
import StatusBadge from "./StatusBadge.astro";
import { frontierProject } from "../data/projects.js";
import { buildLogsForProject } from "../data/build-logs.js";

const p = frontierProject;
const logs = buildLogsForProject(p.slug);
---

<section class="frontier" aria-labelledby="frontier-title">
  <div class="container">
    <p class="section-label">Current frontier project</p>

    <div class="frontier-grid">
      <div class="lede">
        <h2 id="frontier-title">{p.name}</h2>
        <StatusBadge status={p.status} />
        <p class="thesis">{p.summary}</p>
        <p class="role">My role — {p.role}</p>
        <p class="boundary">{p.boundary}</p>

        <div class="actions">
          <a class="btn btn-primary" href={`/projects/${p.slug}`} data-analytics="hero_chaseos_click">
            Read the ChaseOS case study
          </a>
          <a
            class="btn btn-secondary"
            href={p.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="external_product_click"
          >
            Visit chaseos.ai ↗
          </a>
        </div>

        {
          logs.length > 0 && (
            <p class="related">
              Related build log:{" "}
              <a class="text-link" href={`/build-log/${logs[0].slug}`} data-analytics="build_log_open">
                {logs[0].title}
              </a>
            </p>
          )
        }
      </div>

      <div class="systems">
        <p class="systems-label">System areas</p>
        <ul>
          {p.systemAreas.map((area) => <li>{area}</li>)}
        </ul>
        <p class="systems-note">
          Areas reflect the current architecture of the repository, not a
          roadmap of promised features.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .frontier {
    padding: 5rem 0;
    position: relative;
  }
  /* Restrained translucent treatment — the one feature surface (§18.3) */
  .frontier::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 20% 0%,
        rgba(57, 222, 201, 0.07) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse at 90% 100%,
        rgba(141, 124, 243, 0.06) 0%,
        transparent 55%
      );
    pointer-events: none;
  }
  .container {
    position: relative;
  }
  .frontier-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-top: 0.75rem;
  }
  h2 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 0.9rem;
  }
  .thesis {
    color: var(--cit-text-primary);
    font-size: 1.08rem;
    max-width: 58ch;
    margin-top: 1.1rem;
  }
  .role {
    color: var(--cit-text-secondary);
    font-family: var(--cit-font-mono);
    font-size: 0.8rem;
    margin-top: 0.9rem;
  }
  .boundary {
    color: var(--cit-text-muted);
    font-size: 0.82rem;
    font-style: italic;
    margin-top: 0.5rem;
    max-width: 58ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }
  .related {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--cit-text-muted);
  }

  .systems {
    border: 1px solid var(--cit-border);
    background: rgba(19, 33, 38, 0.55);
    backdrop-filter: blur(6px);
    border-radius: var(--cit-radius);
    padding: 1.4rem;
  }
  .systems-label {
    font-family: var(--cit-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cit-accent-teal);
  }
  .systems ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .systems li {
    font-size: 0.88rem;
    color: var(--cit-text-secondary);
    padding-left: 1rem;
    position: relative;
  }
  .systems li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--cit-accent-teal);
  }
  .systems-note {
    margin-top: 1.1rem;
    font-size: 0.75rem;
    color: var(--cit-text-muted);
  }

  @media (max-width: 900px) {
    .frontier-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
  @media (max-width: 640px) {
    .frontier {
      padding: 3rem 0;
    }
    .actions .btn {
      width: 100%;
    }
  }
</style>
