---
interface Props {
  label: string;
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
}
const { label, title, intro, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="section-label">{label}</p>
    <h2>{title}</h2>
    {intro && <p class="intro">{intro}</p>}
  </div>
  {
    href && (
      <a class="text-link" href={href}>
        {linkLabel ?? "View all"} →
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 0.5rem;
  }
  .intro {
    color: var(--cit-text-secondary);
    max-width: 60ch;
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }
</style>
