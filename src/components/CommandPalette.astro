---
import { projects } from "../data/projects.js";
import { nav, activeSocials } from "../data/site.js";
import { publishedBuildLogs } from "../data/build-logs.js";

// ⌘K / Ctrl-K jump menu. Progressive enhancement only — the trigger is hidden
// until JS wires it up, and every destination it offers is reachable from the
// normal navigation.
const entries = [
  ...nav.map((item) => ({ label: item.label, href: item.href, group: "Pages" })),
  { label: "Home", href: "/", group: "Pages" },
  { label: "Links", href: "/links/", group: "Pages" },
  { label: "Now", href: "/now/", group: "Pages" },
  { label: "Search", href: "/search/", group: "Pages" },
  { label: "Press kit", href: "/press/", group: "Pages" },
  { label: "Newsletter", href: "/newsletter/", group: "Pages" },
  { label: "Uses", href: "/uses/", group: "Pages" },
  ...projects.map((p) => ({
    label: p.name,
    href: `/projects/${p.slug}/`,
    group: "Projects",
  })),
  ...publishedBuildLogs.map((e) => ({
    label: e.title,
    href: `/build-log/${e.slug}/`,
    group: "Build log",
  })),
  ...activeSocials.map((s) => ({
    label: s.label,
    href: s.url,
    group: "Elsewhere",
    external: true,
  })),
];
---

<button class="palette-trigger" type="button" data-palette-open hidden>
  <span class="kbd">⌘K</span>
  <span class="sr-only">Open quick navigation</span>
</button>

<div class="palette" data-palette hidden>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-panel" role="dialog" aria-modal="true" aria-label="Quick navigation">
    <input
      class="palette-input"
      type="text"
      placeholder="Jump to a project, page or build log…"
      aria-label="Search destinations"
      autocomplete="off"
      data-palette-input
    />
    <ul class="palette-list" data-palette-list>
      {
        entries.map((entry) => (
          <li>
            <a
              href={entry.href}
              data-label={entry.label.toLowerCase()}
              data-group={entry.group}
              {...(entry.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="label">{entry.label}</span>
              <span class="group">{entry.group}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="palette-empty" data-palette-empty hidden>No matches</p>
  </div>
</div>

<script>
  const setup = () => {
    const trigger = document.querySelector("[data-palette-open]");
    const root = document.querySelector("[data-palette]");
    const input = document.querySelector("[data-palette-input]");
    const list = document.querySelector("[data-palette-list]");
    const empty = document.querySelector("[data-palette-empty]");
    if (!trigger || !root || !input || !list) return;

    trigger.hidden = false;
    const items = [...list.querySelectorAll("li")];
    let lastFocused = null;

    const open = () => {
      lastFocused = document.activeElement;
      root.hidden = false;
      document.body.style.overflow = "hidden";
      input.value = "";
      filter("");
      input.focus();
    };

    const close = () => {
      root.hidden = true;
      document.body.style.overflow = "";
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };

    const filter = (query) => {
      let visible = 0;
      for (const item of items) {
        const label = item.querySelector("a")?.dataset.label ?? "";
        const match = label.includes(query);
        item.hidden = !match;
        if (match) visible++;
      }
      if (empty) empty.hidden = visible > 0;
    };

    trigger.addEventListener("click", open);
    root.querySelector("[data-palette-close]")?.addEventListener("click", close);
    input.addEventListener("input", () => filter(input.value.trim().toLowerCase()));

    document.addEventListener("keydown", (event) => {
      const isToggle = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      if (isToggle) {
        event.preventDefault();
        root.hidden ? open() : close();
        return;
      }
      if (event.key === "Escape" && !root.hidden) close();
      // Down/Up move through the visible results.
      if (!root.hidden && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
        event.preventDefault();
        const links = items.filter((i) => !i.hidden).map((i) => i.querySelector("a"));
        if (links.length === 0) return;
        const current = links.indexOf(document.activeElement);
        const next =
          event.key === "ArrowDown"
            ? (current + 1) % links.length
            : (current - 1 + links.length) % links.length;
        links[next]?.focus();
      }
    });
  };

  setup();
  // Re-bind after a view transition swaps the document.
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .palette-trigger {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 0.5rem 0.7rem;
    border-radius: var(--cit-radius-sm);
    border: 1px solid var(--cit-border-strong);
    background: rgba(11, 21, 24, 0.88);
    backdrop-filter: blur(8px);
    color: var(--cit-text-muted);
    cursor: pointer;
  }
  .palette-trigger:hover {
    color: var(--cit-accent-teal);
    border-color: var(--cit-accent-teal);
  }
  .kbd {
    font-family: var(--cit-font-mono);
    font-size: 0.72rem;
  }

  .palette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: start center;
    padding: 12vh 1.25rem 1.25rem;
  }
  /* The display rules above would otherwise override the `hidden` attribute's
     UA display:none — this line is what makes open/close actually work. */
  .palette[hidden],
  .palette-trigger[hidden] {
    display: none;
  }
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 10, 12, 0.72);
    backdrop-filter: blur(4px);
  }
  .palette-panel {
    position: relative;
    width: 100%;
    max-width: 540px;
    background: var(--cit-bg-surface);
    border: 1px solid var(--cit-border-strong);
    border-radius: var(--cit-radius);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .palette-input {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--cit-border);
    background: transparent;
    color: var(--cit-text-primary);
    font-size: 0.98rem;
    font-family: inherit;
  }
  .palette-input:focus {
    outline: none;
  }
  .palette-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: 46vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--cit-border-strong) transparent;
  }
  .palette-list::-webkit-scrollbar {
    width: 8px;
  }
  .palette-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .palette-list::-webkit-scrollbar-thumb {
    background: var(--cit-border-strong);
    border-radius: 999px;
  }
  .palette-list::-webkit-scrollbar-thumb:hover {
    background: var(--cit-accent-teal);
  }
  .palette-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--cit-radius-sm);
    text-decoration: none;
    color: var(--cit-text-secondary);
    font-size: 0.92rem;
  }
  .palette-list a:hover,
  .palette-list a:focus-visible {
    background: rgba(57, 222, 201, 0.1);
    color: var(--cit-text-primary);
  }
  .group {
    font-family: var(--cit-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cit-text-muted);
    flex-shrink: 0;
  }
  .palette-empty {
    padding: 0.9rem 1.1rem 1.1rem;
    color: var(--cit-text-muted);
    font-size: 0.88rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px
    ;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Touch devices have no ⌘K, so don't advertise it. */
  @media (hover: none) {
    .palette-trigger {
      display: none;
    }
  }
</style>
