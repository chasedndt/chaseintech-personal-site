---
import StatusBadge from "./StatusBadge.astro";

const { project } = Astro.props;
---

<article class="card">
  <div class="card-head">
    <p class="section-label">{project.category}</p>
    <StatusBadge status={project.status} />
  </div>

  <h3>
    <a href={`/projects/${project.slug}`} data-analytics="project_open">
      {project.name}
    </a>
  </h3>

  <p class="outcome">{project.outcome}</p>
  <p class="role">{project.role}</p>

  <ul class="tech">
    {project.technologies.slice(0, 4).map((tech) => <li>{tech}</li>)}
  </ul>

  <div class="card-actions">
    <a class="text-link" href={`/projects/${project.slug}`}>Case study →</a>
    {
      project.repositoryUrl && (
        <a
          class="text-link muted"
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="external_product_click"
        >
          Repo ↗
        </a>
      )
    }
    {
      project.liveUrl && (
        <a
          class="text-link muted"
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="external_product_click"
        >
          Live ↗
        </a>
      )
    }
  </div>
</article>

<style>
  /* Solid surface, not glass — glass is reserved for identity/feature (§18.3) */
  .card {
    border: 1px solid var(--cit-border);
    background: var(--cit-bg-surface);
    border-radius: var(--cit-radius);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--cit-border-strong);
    transform: translateY(-2px);
  }
  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  h3 {
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--cit-accent-teal);
  }
  .outcome {
    color: var(--cit-text-secondary);
    font-size: 0.92rem;
  }
  .role {
    color: var(--cit-text-muted);
    font-family: var(--cit-font-mono);
    font-size: 0.75rem;
  }
  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.15rem 0 0;
    padding: 0;
  }
  .tech li {
    font-size: 0.7rem;
    font-family: var(--cit-font-mono);
    color: var(--cit-text-muted);
    border: 1px solid var(--cit-border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }
  .muted {
    color: var(--cit-text-muted);
  }
  .muted:hover {
    color: var(--cit-accent-teal);
  }
</style>
