---
import PixelMark from "./PixelMark.astro";

// Slowly rotating identity cube. Faces alternate between the faceless pixel
// PFP (X) and the real photo PFP (YouTube / TikTok), so the rotation reads as
// one identity with two public faces.
//
// The photo is not supplied yet: drop it at `public/images/pfp-photo.jpg` and
// set PHOTO_SRC. Until then the photo faces render a labelled placeholder
// rather than a broken image.
const PHOTO_SRC = null;

interface Props {
  size?: number;
}
const { size = 96 } = Astro.props;
---

<div class="cube-stage" style={`--cube-size:${size}px`}>
  <div class="cube">
    <div class="face face--front"><PixelMark /></div>
    <div class="face face--right">
      {
        PHOTO_SRC ? (
          <img src={PHOTO_SRC} alt="Chase" width={size} height={size} />
        ) : (
          <span class="placeholder">PFP</span>
        )
      }
    </div>
    <div class="face face--back"><PixelMark /></div>
    <div class="face face--left">
      {
        PHOTO_SRC ? (
          <img src={PHOTO_SRC} alt="" width={size} height={size} />
        ) : (
          <span class="placeholder">PFP</span>
        )
      }
    </div>
  </div>
</div>

<style>
  .cube-stage {
    width: var(--cube-size);
    height: var(--cube-size);
    perspective: 620px;
    flex-shrink: 0;
  }
  .cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: spin 16s cubic-bezier(0.66, 0, 0.34, 1) infinite;
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 10px;
    background: var(--cit-bg-elevated);
    box-shadow:
      0 0 0 1px var(--cit-border-strong),
      0 0 26px -10px rgba(57, 222, 201, 0.5);
    backface-visibility: hidden;
  }
  .face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    font-family: var(--cit-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--cit-text-muted);
    border: 1px dashed var(--cit-border-strong);
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
  }

  /* Four faces around the Y axis; translateZ is half the cube width. */
  .face--front {
    transform: rotateY(0deg) translateZ(calc(var(--cube-size) / 2));
  }
  .face--right {
    transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2));
  }
  .face--back {
    transform: rotateY(180deg) translateZ(calc(var(--cube-size) / 2));
  }
  .face--left {
    transform: rotateY(270deg) translateZ(calc(var(--cube-size) / 2));
  }

  /* Quarter-turn steps with a pause on each face, so each logo is readable. */
  @keyframes spin {
    0%, 18% { transform: rotateY(0deg); }
    25%, 43% { transform: rotateY(-90deg); }
    50%, 68% { transform: rotateY(-180deg); }
    75%, 93% { transform: rotateY(-270deg); }
    100% { transform: rotateY(-360deg); }
  }

  /* Reduced motion: no rotation, front face only — still complete (§16.4). */
  @media (prefers-reduced-motion: reduce) {
    .cube {
      animation: none;
      transform: none;
    }
    .face:not(.face--front) {
      display: none;
    }
    .face--front {
      transform: none;
    }
  }
</style>
