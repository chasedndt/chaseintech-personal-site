---
// Rotating identity cube with exactly TWO faces, alternating around the four
// sides of the cube so the rotation is continuous:
//   pixel PFP (X) → photo PFP (YouTube/TikTok) → pixel PFP → photo PFP
//
// Both images are the operator's own files, used as supplied. The photo was
// transcoded from HEIC (browsers cannot render HEIC) and centre-cropped square;
// framing is otherwise untouched.
const PIXEL_SRC = "/images/pfp-pixel.png";
const PHOTO_SRC = "/images/pfp-photo.png";

interface Props {
  size?: number;
}
const { size = 96 } = Astro.props;
---

<div class="cube-stage" style={`--cube-size:${size}px`}>
  <div class="cube">
    <div class="face face--front">
      <img class="pixel" src={PIXEL_SRC} alt="ChaseInTech" width={size} height={size} />
    </div>
    <div class="face face--right">
      <img src={PHOTO_SRC} alt="Chase" width={size} height={size} />
    </div>
    <div class="face face--back">
      <img class="pixel" src={PIXEL_SRC} alt="" width={size} height={size} />
    </div>
    <div class="face face--left">
      <img src={PHOTO_SRC} alt="" width={size} height={size} />
    </div>
  </div>
</div>

<style>
  .cube-stage {
    width: var(--cube-size);
    height: var(--cube-size);
    perspective: 620px;
    flex-shrink: 0;
  }
  .cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: spin 24s cubic-bezier(0.66, 0, 0.34, 1) infinite;
  }
  .face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 10px;
    background: var(--cit-bg-elevated);
    box-shadow:
      0 0 0 1px var(--cit-border-strong),
      0 0 26px -10px rgba(57, 222, 201, 0.5);
    backface-visibility: hidden;
  }
  .face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Keep the pixel art crisp rather than letting the browser smooth it. */
  .pixel {
    image-rendering: pixelated;
  }

  /* Four sides around the Y axis; translateZ is half the cube width. */
  .face--front {
    transform: rotateY(0deg) translateZ(calc(var(--cube-size) / 2));
  }
  .face--right {
    transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2));
  }
  .face--back {
    transform: rotateY(180deg) translateZ(calc(var(--cube-size) / 2));
  }
  .face--left {
    transform: rotateY(270deg) translateZ(calc(var(--cube-size) / 2));
  }

  /* Quarter-turn steps over 24s: each face rests ~4.3s, then a ~1.7s turn. */
  @keyframes spin {
    0%, 18% { transform: rotateY(0deg); }
    25%, 43% { transform: rotateY(-90deg); }
    50%, 68% { transform: rotateY(-180deg); }
    75%, 93% { transform: rotateY(-270deg); }
    100% { transform: rotateY(-360deg); }
  }

  /* Reduced motion: no rotation, pixel face only — still complete (§16.4). */
  @media (prefers-reduced-motion: reduce) {
    .cube {
      animation: none;
      transform: none;
    }
    .face:not(.face--front) {
      display: none;
    }
    .face--front {
      transform: none;
    }
  }
</style>
