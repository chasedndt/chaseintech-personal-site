---
// ChaseOS cube face.
//
// This is a WORDMARK — the product name set in the brand palette — not an
// invented logo. The real ChaseOS logo has not been supplied; when it is,
// drop it at `public/images/chaseos-logo.svg` and set LOGO_SRC below.
const LOGO_SRC = null;
---

{
  LOGO_SRC ? (
    <img src={LOGO_SRC} alt="ChaseOS" />
  ) : (
    <div class="wordmark">
      <span class="grid-bg" aria-hidden="true"></span>
      <span class="mark" aria-hidden="true">
        <span class="block block--teal"></span>
        <span class="block block--violet"></span>
        <span class="block block--teal-dim"></span>
        <span class="block block--core"></span>
      </span>
      <span class="name">ChaseOS</span>
    </div>
  )
}

<style>
  .wordmark {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    background: linear-gradient(150deg, #0b1f24 0%, #071014 100%);
    overflow: hidden;
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(57, 222, 201, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(57, 222, 201, 0.1) 1px, transparent 1px);
    background-size: 10px 10px;
  }
  /* Four pixel blocks: the control-plane motif, teal + provenance violet. */
  .mark {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 7px);
    grid-template-rows: repeat(2, 7px);
    gap: 2px;
  }
  .block {
    display: block;
    border-radius: 1px;
  }
  .block--teal {
    background: #39dec9;
    box-shadow: 0 0 8px rgba(57, 222, 201, 0.8);
  }
  .block--violet {
    background: #8d7cf3;
  }
  .block--teal-dim {
    background: rgba(57, 222, 201, 0.45);
  }
  .block--core {
    background: #f2f0e8;
  }
  .name {
    position: relative;
    font-family: var(--cit-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--cit-text-primary);
    text-transform: uppercase;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
