---
import { statusLabels } from "../data/projects.js";

const { status } = Astro.props;
---

<span class={`badge badge--${status}`}>
  <span class="dot" aria-hidden="true"></span>
  {statusLabels[status]}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--cit-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .badge--live {
    color: var(--cit-status-live);
  }
  .badge--development {
    color: var(--cit-status-dev);
  }
  .badge--oss {
    color: var(--cit-status-oss);
  }
  .badge--research {
    color: var(--cit-status-research);
  }
  .badge--prototype {
    color: var(--cit-status-prototype);
  }
  .badge--archived {
    color: var(--cit-status-archived);
  }
  .badge--private {
    color: var(--cit-status-private);
  }
</style>
