---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectCardRuntime from "../../components/ProjectCardRuntime.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { projects, frontierProject, categories, statusLabels } from "../../data/projects.js";

const mediaBySlug = Object.fromEntries(
  projects.map((p) => [p.slug, p.media ?? []]),
);
import { site } from "../../data/site.js";

const grouped = Object.values(categories)
  .map((category) => ({
    category,
    items: projects.filter((p) => p.category === category && !p.frontier),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title={`Projects — ${site.brand}`}
  description="The full project portfolio: agentic AI infrastructure, full-stack products, trading and data engineering, security research and creative tooling."
>
  <div class="container page-head">
    <p class="section-label">Portfolio</p>
    <h1>Projects</h1>
    <p class="intro">
      Every project below is labelled with its real current state. Research and
      prototypes are named as such — nothing here is described as a production
      product unless it is one.
    </p>
  </div>

  <div class="container">
    <a class="frontier-row" href={`/projects/${frontierProject.slug}/`}>
      <div>
        <p class="section-label">Current frontier project</p>
        <h2>{frontierProject.name}</h2>
        <p class="frontier-summary">{frontierProject.summary}</p>
      </div>
      <StatusBadge status={frontierProject.status} />
    </a>
  </div>

  <div class="container filter-row" data-filter-row hidden>
    <span class="filter-label">Filter</span>
    <button class="chip is-active" data-filter="all" type="button">All</button>
    {
      [...new Set(projects.filter((p) => !p.frontier).map((p) => p.status))].map(
        (status) => (
          <button class="chip" data-filter={status} type="button">
            {statusLabels[status]}
          </button>
        ),
      )
    }
  </div>

  {
    grouped.map((group) => (
      <section class="group container" data-group>
        <h2 class="group-title">{group.category}</h2>
        <div class="grid">
          {group.items.map((project) => (
            <div data-project-status={project.status}>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <script>
    // Status filter — progressive enhancement: the row is hidden until JS
    // wires it, so without JS the page is simply the full unfiltered list.
    const initFilter = () => {
      const row = document.querySelector("[data-filter-row]");
      if (!row || row.dataset.ready) return;
      row.dataset.ready = "1";
      row.hidden = false;

      const chips = [...row.querySelectorAll("[data-filter]")];
      const cards = [...document.querySelectorAll("[data-project-status]")];
      const groups = [...document.querySelectorAll("[data-group]")];

      row.addEventListener("click", (event) => {
        const chip = event.target.closest("[data-filter]");
        if (!chip) return;
        chips.forEach((c) => c.classList.toggle("is-active", c === chip));
        const wanted = chip.dataset.filter;
        cards.forEach((card) => {
          card.hidden = wanted !== "all" && card.dataset.projectStatus !== wanted;
        });
        groups.forEach((group) => {
          group.hidden = ![...group.querySelectorAll("[data-project-status]")].some(
            (card) => !card.hidden,
          );
        });
      });
    };
    initFilter();
    document.addEventListener("astro:page-load", initFilter);
  </script>
  <ProjectCardRuntime mediaBySlug={mediaBySlug} />
</Layout>

<style>
  .page-head {
    padding: 4rem 0 2.5rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
    margin-top: 0.6rem;
  }
  .intro {
    color: var(--cit-text-secondary);
    max-width: 62ch;
    margin-top: 1rem;
  }
  .frontier-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    text-decoration: none;
    border: 1px solid var(--cit-border-strong);
    border-radius: var(--cit-radius);
    padding: 1.6rem;
    background:
      radial-gradient(ellipse at 0% 0%, rgba(57, 222, 201, 0.08), transparent 65%),
      var(--cit-bg-surface);
    transition: border-color 0.2s ease;
  }
  .frontier-row:hover {
    border-color: var(--cit-accent-teal);
  }
  .frontier-row h2 {
    font-size: 1.6rem;
    margin-top: 0.5rem;
  }
  .frontier-summary {
    color: var(--cit-text-secondary);
    font-size: 0.92rem;
    margin-top: 0.6rem;
    max-width: 62ch;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .filter-row[hidden] {
    display: none;
  }
  .filter-label {
    font-family: var(--cit-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cit-text-muted);
    margin-right: 0.4rem;
  }
  .chip {
    font-family: var(--cit-font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--cit-border);
    background: transparent;
    color: var(--cit-text-secondary);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .chip:hover {
    border-color: var(--cit-accent-teal);
    color: var(--cit-accent-teal);
  }
  .chip.is-active {
    border-color: var(--cit-accent-teal);
    color: var(--cit-accent-teal);
    background: rgba(57, 222, 201, 0.08);
  }
  .group {
    margin-top: 3.5rem;
  }
  .group-title {
    font-size: 1.15rem;
    color: var(--cit-text-secondary);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--cit-border);
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
  }
</style>
