---
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import WorkWithMeCTA from "../../components/WorkWithMeCTA.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import MediaGallery from "../../components/MediaGallery.astro";
import ArchitectureDiagram from "../../components/ArchitectureDiagram.astro";
import { packs, packBoundary, forgeIndexUrl } from "../../data/forge.js";
import { projects } from "../../data/projects.js";
import { buildLogsForProject } from "../../data/build-logs.js";
import { site } from "../../data/site.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const logs = buildLogsForProject(project.slug);
---

<Layout
  title={`${project.name} — ${site.brand}`}
  description={project.summary}
>
  <article>
    <header class="container page-head">
      <p class="section-label">{project.category}</p>
      <h1>{project.name}</h1>
      <div class="meta">
        <StatusBadge status={project.status} />
        <span class="role">{project.role}</span>
      </div>
      <p class="summary">{project.summary}</p>

      <div class="actions">
        {
          project.liveUrl && (
            <a
              class="btn btn-primary"
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics="external_product_click"
            >
              Visit live product ↗
            </a>
          )
        }
        {
          project.repositoryUrl && (
            <a
              class="btn btn-secondary"
              href={project.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics="external_product_click"
            >
              View repository ↗
            </a>
          )
        }
      </div>
      {project.links?.length > 0 && (
        <div class="project-link-row">
          <ProjectLinks links={project.links} />
        </div>
      )}
    </header>

    <div class="container body">
      <section>
        <h2>Outcome</h2>
        <p>{project.outcome}</p>
      </section>

      <MediaGallery media={project.media} />

      {
        project.caseStudy && (
          <section class="case-study">
            <h2>Case study</h2>
            <div class="case-sections">
              {project.caseStudy.map((section) => (
                <section>
                  <h3>{section.heading}</h3>
                  <p>{section.body}</p>
                </section>
              ))}
            </div>
          </section>
        )
      }


      <section>
        <h2>Technology</h2>
        <ul class="tech">
          {project.technologies.map((tech) => <li>{tech}</li>)}
        </ul>
      </section>

      {
        project.components && (
          <section>
            <h2>What's shipped inside it</h2>
            <ul class="components">
              {project.components.map((component) => (
                <li>
                  <div class="component-head">
                    <h3>
                      {component.url ? (
                        <a
                          href={component.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-analytics="external_product_click"
                        >
                          {component.name} ↗
                        </a>
                      ) : (
                        component.name
                      )}
                    </h3>
                    <StatusBadge status={component.status} />
                  </div>
                  <p>{component.detail}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {project.slug === "chaseos" && <ArchitectureDiagram />}

      {
        project.slug === "chaseos" && (
          <section class="forge">
            <h2>Forge workflow packs</h2>
            <p class="forge-lede">
              First-party packs on the live Forge marketplace, each publishing
              its contract — permissions, approval gates and output shapes —
              before it runs. Snapshot from the public structured index.
            </p>
            <ul class="forge-grid">
              {packs.map((pack) => (
                <li>
                  <p class="forge-cat">{pack.category}</p>
                  <h3>{pack.name}</h3>
                  <p class="forge-desc">{pack.description}</p>
                  <ul class="forge-artifacts">
                    {pack.artifacts.map((artifact) => (
                      <li>{artifact}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
            <p class="forge-boundary">{packBoundary}</p>
            <a
              class="text-link"
              href={forgeIndexUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics="external_product_click"
            >
              Browse Forge live ↗
            </a>
          </section>
        )
      }

      {
        project.systemAreas && (
          <section>
            <h2>System areas</h2>
            <ul class="areas">
              {project.systemAreas.map((area) => (
                <li>{area}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        project.subProjects && (
          <section>
            <h2>Inside this system</h2>
            <ul class="subs">
              {project.subProjects.map((sub) => (
                <li>
                  <div class="sub-head">
                    <h3>{sub.name}</h3>
                    <StatusBadge status={sub.status} />
                  </div>
                  <p>{sub.summary}</p>
                  {sub.repositoryUrl ? (
                    <a
                      class="text-link"
                      href={sub.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-analytics="external_product_click"
                    >
                      Repository ↗
                    </a>
                  ) : (
                    <span class="no-repo">Repository not public</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="boundary-note">
        <h2>Scope and boundaries</h2>
        <p>{project.boundary}</p>
      </section>

      {
        logs.length > 0 && (
          <section>
            <h2>Related build logs</h2>
            <ul class="related">
              {logs.map((entry) => (
                <li>
                  <a href={`/build-log/${entry.slug}`} data-analytics="build_log_open">
                    {entry.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <p class="back">
        <a class="text-link" href="/projects">← All projects</a>
      </p>
    </div>
  </article>

  <WorkWithMeCTA />
</Layout>

<style>
  .page-head {
    padding: 4rem 0 2rem;
    max-width: 820px;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.1rem);
    margin-top: 0.6rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.1rem;
  }
  .role {
    font-family: var(--cit-font-mono);
    font-size: 0.78rem;
    color: var(--cit-text-muted);
  }
  .summary {
    color: var(--cit-text-secondary);
    font-size: 1.05rem;
    margin-top: 1.2rem;
    max-width: 62ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.9rem;
  }
  .project-link-row {
    margin-top: 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--cit-border);
  }
  .body {
    max-width: 820px;
    padding-bottom: 3rem;
    display: grid;
    gap: 2.5rem;
  }
  .body h2 {
    font-size: 0.78rem;
    font-family: var(--cit-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cit-accent-teal);
    margin-bottom: 0.9rem;
  }
  .body p {
    color: var(--cit-text-secondary);
    max-width: 68ch;
  }
  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
  }
  .tech li {
    font-family: var(--cit-font-mono);
    font-size: 0.75rem;
    color: var(--cit-text-secondary);
    border: 1px solid var(--cit-border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 0.5rem;
  }
  .areas li {
    font-size: 0.9rem;
    color: var(--cit-text-secondary);
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius-sm);
    background: var(--cit-bg-surface);
  }
  .subs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .subs li {
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.2rem;
    background: var(--cit-bg-surface);
  }
  .sub-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .sub-head h3 {
    font-size: 1rem;
    overflow-wrap: anywhere;
  }
  .subs p {
    font-size: 0.9rem;
    margin: 0.5rem 0 0.7rem;
  }
  .no-repo {
    font-family: var(--cit-font-mono);
    font-size: 0.75rem;
    color: var(--cit-text-muted);
  }
  .forge-lede {
    margin-bottom: 1.2rem;
    font-size: 0.92rem;
  }
  .forge-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 0.9rem;
  }
  .forge-grid > li {
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.1rem 1.2rem;
    background: var(--cit-bg-surface);
  }
  .forge-cat {
    font-family: var(--cit-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cit-accent-violet);
  }
  .forge-grid h3 {
    font-size: 0.98rem;
    margin-top: 0.35rem;
  }
  .forge-desc {
    font-size: 0.85rem;
    margin-top: 0.45rem;
  }
  .forge-artifacts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.7rem 0 0;
    padding: 0;
  }
  .forge-artifacts li {
    font-family: var(--cit-font-mono);
    font-size: 0.64rem;
    color: var(--cit-text-muted);
    border: 1px solid var(--cit-border);
    border-radius: 999px;
    padding: 0.12rem 0.45rem;
  }
  .forge-boundary {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--cit-text-muted);
    margin: 1.1rem 0 0.8rem;
  }
  .case-study {
    border-top: 1px solid var(--cit-border);
    padding-top: 2rem;
  }
  .case-sections {
    display: grid;
    gap: 1.8rem;
    margin-top: 0.4rem;
  }
  .case-sections h3 {
    font-size: 1.05rem;
    color: var(--cit-text-primary);
    margin-bottom: 0.5rem;
  }
  .case-sections p {
    line-height: 1.75;
  }
  .components {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .components li {
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.1rem 1.2rem;
    background: var(--cit-bg-surface);
  }
  .component-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .components h3 {
    font-size: 1rem;
    overflow-wrap: anywhere;
  }
  .components h3 a {
    text-decoration: none;
    color: var(--cit-accent-teal);
  }
  .components h3 a:hover {
    text-decoration: underline;
  }
  .components p {
    font-size: 0.88rem;
    margin-top: 0.5rem;
  }
  .boundary-note {
    border-left: 2px solid var(--cit-accent-violet);
    padding-left: 1.2rem;
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .related a {
    color: var(--cit-accent-teal);
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
  .back {
    margin-top: 1rem;
  }
</style>
