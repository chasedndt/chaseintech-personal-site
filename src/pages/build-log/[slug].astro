---
import Layout from "../../layouts/Layout.astro";
import { publishedBuildLogs } from "../../data/build-logs.js";
import { getProject } from "../../data/projects.js";
import { site } from "../../data/site.js";

export function getStaticPaths() {
  return publishedBuildLogs.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: publishedBuildLogs[index - 1] ?? null,
      next: publishedBuildLogs[index + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const project = entry.relatedProject ? getProject(entry.relatedProject) : null;
const slugify = (text) => text.toLowerCase().replace(/[^a-z0-9]+/g, "-");

// Reading time from the actual prose, at a conservative 200 wpm.
const words = entry.sections.reduce(
  (total, section) => total + section.body.trim().split(/\s+/).length,
  0,
);
const readingMinutes = Math.max(1, Math.round(words / 200));
---

<Layout title={`${entry.title} — ${site.brand}`} description={entry.summary}>
  <script>
    // Heading anchors also copy the full URL to the clipboard, with a brief
    // inline confirmation. Navigation still works if clipboard access fails.
    const initCopyAnchors = () => {
      document.querySelectorAll(".anchor").forEach((anchor) => {
        if (anchor.dataset.copyBound) return;
        anchor.dataset.copyBound = "1";
        anchor.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(
              new URL(anchor.getAttribute("href"), location.href).href,
            );
            const original = anchor.textContent;
            anchor.textContent = "copied";
            setTimeout(() => (anchor.textContent = original), 1200);
          } catch {
            /* fall through to normal anchor navigation */
          }
        });
      });
    };
    initCopyAnchors();
    document.addEventListener("astro:page-load", initCopyAnchors);
  </script>

  <article class="container entry">
    <header>
      <p class="section-label">Build log</p>
      <h1>{entry.title}</h1>
      <p class="meta">
        <time datetime={entry.publishedAt}>{entry.publishedAt}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
        {project && (
          <>
            <span aria-hidden="true">·</span>
            <a href={`/projects/${project.slug}/`}>{project.name}</a>
          </>
        )}
      </p>
      <p class="summary">{entry.summary}</p>
      <p class="source">Source: {entry.source}</p>
    </header>

    <nav class="toc" aria-label="On this page">
      <p class="toc-label">On this page</p>
      <ol>
        {
          entry.sections.map((section) => (
            <li>
              <a href={`#${slugify(section.heading)}`}>{section.heading}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="prose">
      {
        entry.sections.map((section) => (
          <section id={slugify(section.heading)}>
            <h2>
              {section.heading}
              <a
                class="anchor"
                href={`#${slugify(section.heading)}`}
                aria-label={`Link to ${section.heading}`}
              >
                #
              </a>
            </h2>
            <p>{section.body}</p>
          </section>
        ))
      }
    </div>

    <footer class="entry-footer">
      {
        project && (
          <p>
            Project case study:{" "}
            <a class="text-link" href={`/projects/${project.slug}/`} data-analytics="project_open">
              {project.name} →
            </a>
          </p>
        )
      }
      <div class="pager">
        {prev ? (
          <a href={`/build-log/${prev.slug}/`}>← {prev.title}</a>
        ) : (
          <span />
        )}
        {next && <a class="next" href={`/build-log/${next.slug}/`}>{next.title} →</a>}
      </div>
      <p><a class="text-link" href="/build-log/">← All build logs</a></p>
    </footer>
  </article>
</Layout>

<style>
  .entry {
    max-width: 760px;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.7rem);
    margin-top: 0.6rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--cit-font-mono);
    font-size: 0.75rem;
    color: var(--cit-text-muted);
    margin-top: 1rem;
  }
  .meta a {
    color: var(--cit-accent-teal);
    text-decoration: none;
  }
  .summary {
    color: var(--cit-text-secondary);
    font-size: 1.05rem;
    margin-top: 1.2rem;
  }
  .source {
    font-family: var(--cit-font-mono);
    font-size: 0.72rem;
    color: var(--cit-text-muted);
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--cit-border);
  }
  .toc {
    margin: 2.5rem 0;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    background: var(--cit-bg-surface);
  }
  .toc-label {
    font-family: var(--cit-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cit-text-muted);
  }
  .toc ol {
    margin: 0.8rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--cit-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .toc a:hover {
    color: var(--cit-accent-teal);
  }
  .prose {
    display: grid;
    gap: 2.2rem;
  }
  .prose h2 {
    font-size: 0.78rem;
    font-family: var(--cit-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cit-accent-teal);
    margin-bottom: 0.8rem;
    scroll-margin-top: 90px;
  }
  /* Anchor stays hidden until hover/focus, but is always keyboard reachable. */
  .anchor {
    margin-left: 0.5rem;
    color: var(--cit-text-muted);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .prose h2:hover .anchor,
  .anchor:focus-visible {
    opacity: 1;
  }
  section {
    scroll-margin-top: 90px;
  }
  .prose p {
    color: var(--cit-text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }
  .entry-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cit-border);
    display: grid;
    gap: 1.2rem;
    color: var(--cit-text-muted);
    font-size: 0.9rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pager a {
    color: var(--cit-text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    max-width: 45%;
  }
  .pager a:hover {
    color: var(--cit-accent-teal);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
