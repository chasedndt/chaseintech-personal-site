---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import { site, activeSocials, email, emailOperational } from "../data/site.js";
import EmailLink from "../components/EmailLink.astro";
---

<Layout
  title={`Press kit — ${site.brand}`}
  description="Bio, approved descriptions, imagery and links for ChaseInTech — for podcasts, collaborations and press."
>
  <div class="container page">
    <p class="section-label">Press kit</p>
    <h1>ChaseInTech, ready to paste</h1>
    <p class="intro">
      Everything a host, collaborator or writer needs, pre-approved. If it's on
      this page, you can use it without asking.
    </p>

    <section>
      <h2>Short bio</h2>
      <p class="quotable">
        Chase is a London-based AI engineer, founder and creator building
        agentic systems, full-stack products and the governance infrastructure
        that makes it safe to let software act on your behalf. He builds in
        public as ChaseInTech, and his frontier project is ChaseOS — a human-AI
        operating system where agents draft, implement and test freely, but
        cannot deploy, spend or publish without a person saying yes.
      </p>
    </section>

    <section>
      <h2>One-liner</h2>
      <p class="quotable">
        London-based AI engineer building ChaseOS in public — agentic systems
        with human approval gates built in.
      </p>
    </section>

    <section>
      <h2>Imagery</h2>
      <div class="imagery">
        <figure>
          <Avatar size={96} />
          <figcaption>
            Pixel avatar — <a href="/images/pfp-pixel.png" download>download PNG</a>
          </figcaption>
        </figure>
        <figure>
          <img class="photo" src="/images/pfp-photo.png" alt="Chase" width="96" height="96" />
          <figcaption>
            Photo — <a href="/images/pfp-photo.png" download>download PNG</a>
          </figcaption>
        </figure>
      </div>
      <p class="note">
        Use either as supplied; please don't recolour, crop into other artwork,
        or generate derivatives.
      </p>
    </section>

    <section>
      <h2>Approved project descriptions</h2>
      <ul class="projects">
        <li>
          <strong>ChaseOS</strong> — a human-AI operating system and governance
          layer for orchestrating agents, projects, knowledge, approvals and
          persistent digital workflows. In development; the Forge workflow-pack
          marketplace is live at chaseos.ai.
        </li>
        <li>
          <strong>Chaser Agent</strong> — an open-source, review-first agent
          harness that separates source claims, evidence, uncertainty and
          proposed actions so a human can decide what to trust.
        </li>
        <li>
          <strong>StrikeZone Crypto</strong> — a trading-systems R&amp;D
          workspace: audited Pine Script indicators and a governed daily
          market-intelligence workflow. No live trade execution.
        </li>
      </ul>
    </section>

    <section>
      <h2>Links</h2>
      <ul class="links">
        <li><a href={site.url}>{site.domain}</a> — home</li>
        <li><a href="https://chaseos.ai">chaseos.ai</a> — ChaseOS product site</li>
        {activeSocials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer">
              {social.label}
            </a>
            {social.handle && <span class="handle"> — {social.handle}</span>}
          </li>
        ))}
      </ul>
    </section>

    {
      emailOperational && (
        <section>
          <h2>Contact</h2>
          <p>
            <EmailLink className="text-link" />
          </p>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .page {
    max-width: 720px;
    padding: 4rem 1.5rem 3.5rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin-top: 0.6rem;
  }
  .intro {
    color: var(--cit-text-secondary);
    margin-top: 1rem;
    max-width: 58ch;
  }
  section {
    margin-top: 2.6rem;
  }
  h2 {
    font-size: 0.78rem;
    font-family: var(--cit-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cit-accent-teal);
    margin-bottom: 0.9rem;
  }
  .quotable {
    color: var(--cit-text-secondary);
    line-height: 1.75;
    border-left: 2px solid var(--cit-accent-teal);
    padding-left: 1.1rem;
  }
  .imagery {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  figure {
    margin: 0;
    display: grid;
    gap: 0.6rem;
    justify-items: center;
  }
  figcaption {
    font-size: 0.78rem;
    color: var(--cit-text-muted);
  }
  figcaption a {
    color: var(--cit-accent-teal);
  }
  .photo {
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--cit-border-strong);
  }
  .note {
    font-size: 0.8rem;
    color: var(--cit-text-muted);
    margin-top: 1rem;
    font-style: italic;
  }
  .projects,
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    color: var(--cit-text-secondary);
    line-height: 1.65;
  }
  .links a {
    color: var(--cit-accent-teal);
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .handle {
    font-family: var(--cit-font-mono);
    font-size: 0.8rem;
    color: var(--cit-text-muted);
  }
</style>
