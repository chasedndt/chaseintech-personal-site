---
import Layout from "../layouts/Layout.astro";
import AmbientHeroScene from "../components/AmbientHeroScene.astro";
import LogoCube from "../components/LogoCube.astro";
import SocialIconRow from "../components/SocialIconRow.astro";
import FrontierProjectFeature from "../components/FrontierProjectFeature.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import VideoCard from "../components/VideoCard.astro";
import WorkWithMeCTA from "../components/WorkWithMeCTA.astro";
import { site } from "../data/site.js";
import { featuredProjects, frontierProject } from "../data/projects.js";
import { getContentFeed } from "../data/videos.js";
import { publishedBuildLogs } from "../data/build-logs.js";

const latestLogs = publishedBuildLogs.slice(0, 2);
const { featured: featuredVideo, recent: recentVideos } = await getContentFeed();
---

<Layout bare>
  <!-- Atmospheric personal hero (§13) -->
  <section class="hero">
    <AmbientHeroScene />

    <div class="container hero-inner">
      <div class="identity-card">
        <div class="card-top">
          <LogoCube size={84} />
          <SocialIconRow size="sm" />
        </div>

        <p class="eyebrow">London · Agentic AI · Software · Creator</p>
        <h1>{site.brand}</h1>
        <p class="signature">{site.signature}</p>

        <p class="bio">
          I'm Chase, a London-based AI engineer, founder and creator building
          agentic systems, full-stack products and the infrastructure behind
          them.
        </p>

        <a class="frontier-status" href={`/projects/${frontierProject.slug}`}>
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-label">Current frontier project</span>
          <span class="status-value">{frontierProject.name}</span>
        </a>

        <div class="hero-actions">
          <a
            class="btn btn-primary"
            href={`/projects/${frontierProject.slug}`}
            data-analytics="hero_chaseos_click"
          >
            Explore ChaseOS
          </a>
          <a class="btn btn-secondary" href="/projects" data-analytics="hero_projects_click">
            View Projects
          </a>
        </div>

        <a class="btn-quiet work-link" href="/work-with-me" data-analytics="work_with_me_click">
          Work with me
        </a>
      </div>
    </div>

    <a class="scroll-cue" href="#frontier" aria-label="Scroll to content">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <div id="frontier">
    <FrontierProjectFeature />
  </div>

  <!-- Watch the Build (§21) -->
  <section class="band">
    <div class="container">
      <div data-reveal>
      <SectionHeading
        label="Watch the build"
        title="Latest from ChaseInTech"
        intro="Build sessions, technical walkthroughs and work-in-progress from the systems on this page."
        href="/videos"
        linkLabel="All videos"
      />
      </div>

      {
        featuredVideo ? (
          <div class="video-grid">
            <VideoCard video={featuredVideo} featured />
            {recentVideos.map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        ) : (
          <p class="empty-state">
            <span>Video library is being set up. Follow along on </span>
            <a class="text-link" href="https://x.com/ChaserCrypto_" target="_blank" rel="noopener noreferrer" data-analytics="x_click">X</a>
            <span> in the meantime.</span>
          </p>
        )
      }
    </div>
  </section>

  <!-- Selected projects (§23) -->
  <section class="band band--alt">
    <div class="container">
      <div data-reveal>
      <SectionHeading
        label="Selected projects"
        title="Systems I've designed and shipped"
        intro="A curated set — the full portfolio, including archived and research work, lives on the projects page."
        href="/projects"
        linkLabel="All projects"
      />
      </div>
      <div class="project-grid">
        {
          featuredProjects.map((project) => (
            <div data-reveal>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Engineering build log (§25) -->
  <section class="band">
    <div class="container">
      <div data-reveal>
      <SectionHeading
        label="Engineering build log"
        title="How the decisions actually got made"
        intro="Architecture, trade-offs, failures and corrections — written from the repositories rather than from memory."
        href="/build-log"
        linkLabel="All entries"
      />
      </div>
      <ul class="log-list">
        {
          latestLogs.map((entry) => (
            <li data-reveal>
              <a href={`/build-log/${entry.slug}`} data-analytics="build_log_open">
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
                <ul class="tags">
                  {entry.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <WorkWithMeCTA />
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding: 6rem 0 5rem;
    isolation: isolate;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    justify-items: center;
  }

  /* Glass identity surface — the one place glass is used on this page (§18.3) */
  .identity-card {
    width: 100%;
    max-width: 620px;
    background: var(--cit-glass);
    backdrop-filter: blur(8px);
    transform: translateZ(0);
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius-lg);
    padding: 2rem;
    box-shadow: 0 24px 70px -30px rgba(0, 0, 0, 0.9);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--cit-border);
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    margin: 0.6rem 0 0;
  }
  .signature {
    color: var(--cit-accent-teal);
    font-family: var(--cit-font-mono);
    font-size: 0.95rem;
    margin-top: 0.6rem;
  }
  .bio {
    color: var(--cit-text-secondary);
    margin-top: 1.1rem;
    max-width: 52ch;
  }

  .frontier-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.6rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--cit-border);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--cit-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(57, 222, 201, 0.06);
  }
  .frontier-status:hover {
    border-color: var(--cit-accent-teal);
  }
  /* Static dot — deliberately not an animated "live" pulse (§13.5) */
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cit-accent-teal);
    box-shadow: 0 0 8px var(--cit-accent-teal);
  }
  .status-label {
    color: var(--cit-text-muted);
  }
  .status-value {
    color: var(--cit-accent-teal);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }
  .work-link {
    display: inline-block;
    margin-top: 1.1rem;
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 26px;
    height: 42px;
    border: 1px solid var(--cit-border-strong);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 8px;
  }
  .scroll-cue span {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--cit-accent-teal);
    animation: cue 1.9s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(9px); opacity: 0.25; }
  }

  .band {
    padding: 4.5rem 0;
  }
  .band--alt {
    background: var(--cit-bg-surface);
    border-top: 1px solid var(--cit-border);
    border-bottom: 1px solid var(--cit-border);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.25rem;
  }
  .video {
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.25rem;
    text-decoration: none;
    background: var(--cit-bg-surface);
  }
  .empty-state {
    color: var(--cit-text-muted);
    border: 1px dashed var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.5rem;
    font-size: 0.92rem;
  }
  .empty-state a {
    margin: 0 0.25rem;
  }

  .log-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .log-list > li > a {
    display: block;
    text-decoration: none;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.4rem;
    background: var(--cit-bg-surface);
    transition: border-color 0.2s ease;
  }
  .log-list > li > a:hover {
    border-color: var(--cit-accent-teal);
  }
  .log-list h3 {
    font-size: 1.1rem;
  }
  .log-list p {
    color: var(--cit-text-secondary);
    font-size: 0.92rem;
    margin-top: 0.5rem;
    max-width: 70ch;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--cit-font-mono);
    font-size: 0.68rem;
    color: var(--cit-text-muted);
    border: 1px solid var(--cit-border);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }

  /* Mobile hero deliberately recalls the legacy vertical card (§15) */
  @media (max-width: 640px) {
    .hero {
      padding: 5rem 0 4.5rem;
      min-height: auto;
    }
    .identity-card {
      padding: 1.5rem 1.25rem;
    }
    .card-top {
      justify-content: center;
      gap: 1.1rem;
      flex-direction: column;
    }
    .hero-inner {
      text-align: center;
    }
    .bio {
      margin-left: auto;
      margin-right: auto;
    }
    .frontier-status {
      display: flex;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .band {
      padding: 3rem 0;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
