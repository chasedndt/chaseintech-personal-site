---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site.js";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const fmt = (date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Layout
  title={`Articles — ${site.brand}`}
  description="Writing on agentic AI, governed automation, systems architecture and building in public."
>
  <div class="container page-head">
    <p class="section-label">Writing</p>
    <h1>Articles</h1>
    <p class="intro">
      Notes on agentic AI, governed automation and systems architecture. Posts
      published here are the canonical version — anything you see on X or
      LinkedIn points back to these pages.
    </p>
    <a class="text-link" href="/rss.xml">Subscribe via RSS →</a>
  </div>

  <div class="container">
    {
      articles.length > 0 ? (
        <ul class="entries">
          {articles.map((article) => (
            <li data-reveal>
              <a href={`/articles/${article.id}`}>
                <p class="date">
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {fmt(article.data.publishedAt)}
                  </time>
                </p>
                <h2>{article.data.title}</h2>
                <p class="desc">{article.data.description}</p>
                {article.data.tags.length > 0 && (
                  <ul class="tags">
                    {article.data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <h2>Nothing published yet</h2>
          <p>
            The pipeline is live and validated — articles appear here the moment
            the first one is committed, and the RSS feed picks them up with no
            further work.
          </p>
          <a class="btn btn-secondary" href="/rss.xml">View the feed</a>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .page-head {
    padding: 4rem 0 2.5rem;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3rem);
    margin-top: 0.6rem;
  }
  .intro {
    color: var(--cit-text-secondary);
    max-width: 62ch;
    margin: 1rem 0 1.2rem;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0 0 3rem;
    display: grid;
    gap: 1rem;
  }
  .entries > li > a {
    display: block;
    text-decoration: none;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 1.6rem;
    background: var(--cit-bg-surface);
    transition: border-color 0.2s ease;
  }
  .entries > li > a:hover {
    border-color: var(--cit-accent-teal);
  }
  .date {
    font-family: var(--cit-font-mono);
    font-size: 0.72rem;
    color: var(--cit-text-muted);
  }
  h2 {
    font-size: 1.3rem;
    margin-top: 0.5rem;
  }
  .desc {
    color: var(--cit-text-secondary);
    font-size: 0.93rem;
    margin-top: 0.6rem;
    max-width: 70ch;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--cit-font-mono);
    font-size: 0.68rem;
    color: var(--cit-text-muted);
    border: 1px solid var(--cit-border);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }
  .empty {
    border: 1px dashed var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 2.5rem;
    max-width: 620px;
    margin-bottom: 3rem;
  }
  .empty h2 {
    font-size: 1.2rem;
    margin-top: 0;
  }
  .empty p {
    color: var(--cit-text-secondary);
    margin: 0.9rem 0 1.6rem;
    font-size: 0.95rem;
  }
</style>
