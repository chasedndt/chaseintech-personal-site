---
import Layout from "../../layouts/Layout.astro";
import VideoCard from "../../components/VideoCard.astro";
import { getContentFeed } from "../../data/videos.js";
import { site, activeSocials } from "../../data/site.js";
import { CHANNEL_URL } from "../../lib/youtube.js";

const { videos, featured, source } = await getContentFeed();
const rest = videos.filter((v) => v !== featured);
const tiktok = activeSocials.find((s) => s.id === "tiktok");
---

<Layout
  title={`Videos — ${site.brand}`}
  description="Build sessions, technical walkthroughs and project demonstrations from ChaseInTech."
>
  <div class="container page-head">
    <p class="section-label">Watch the build</p>
    <h1>Videos</h1>
    <p class="intro">
      Build sessions and technical walkthroughs, pulled from the ChaseInTech
      YouTube channel.
    </p>
    <div class="head-actions">
      <a
        class="btn btn-secondary"
        href={CHANNEL_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics="youtube_click"
      >
        Subscribe on YouTube ↗
      </a>
      {
        tiktok && (
          <a
            class="btn btn-secondary"
            href={tiktok.url}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="tiktok_click"
          >
            TikTok ↗
          </a>
        )
      }
    </div>
  </div>

  <div class="container filter-row" data-filter-row hidden>
    <span class="filter-label">Show</span>
    <button class="chip is-active" data-filter="all" type="button">All</button>
    <button class="chip" data-filter="long" type="button">Videos</button>
    <button class="chip" data-filter="short" type="button">Shorts</button>
  </div>

  <div class="container">
    {
      featured && (
        <div class="featured" data-video-format={featured.youtube.format ?? "long"}>
          <VideoCard video={featured} featured />
        </div>
      )
    }

    {
      rest.length > 0 && (
        <ul class="grid">
          {rest.map((video) => (
            <li data-video-format={video.youtube.format ?? "long"}>
              <VideoCard video={video} />
            </li>
          ))}
        </ul>
      )
    }

    {
      videos.length === 0 && (
        <p class="empty">
          The feed could not be loaded for this build. It will repopulate on the
          next deploy.
        </p>
      )
    }

    <p class="feed-note">
      {videos.length} video{videos.length === 1 ? "" : "s"} · feed read from
      YouTube at build time{source === "snapshot" ? " (showing last cached copy)" : ""}
    </p>
  </div>
  <script>
    const initVideoFilter = () => {
      const row = document.querySelector("[data-filter-row]");
      if (!row || row.dataset.ready) return;
      row.dataset.ready = "1";
      row.hidden = false;
      const chips = [...row.querySelectorAll("[data-filter]")];
      const items = [...document.querySelectorAll("[data-video-format]")];
      row.addEventListener("click", (event) => {
        const chip = event.target.closest("[data-filter]");
        if (!chip) return;
        chips.forEach((c) => c.classList.toggle("is-active", c === chip));
        const wanted = chip.dataset.filter;
        items.forEach((item) => {
          item.hidden = wanted !== "all" && item.dataset.videoFormat !== wanted;
        });
      });
    };
    initVideoFilter();
    document.addEventListener("astro:page-load", initVideoFilter);
  </script>
</Layout>

<style>
  .page-head {
    padding: 4rem 0 2.5rem;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3rem);
    margin-top: 0.6rem;
  }
  .intro {
    color: var(--cit-text-secondary);
    max-width: 60ch;
    margin-top: 1rem;
  }
  .head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }
  .filter-row[hidden] {
    display: none;
  }
  .filter-label {
    font-family: var(--cit-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cit-text-muted);
    margin-right: 0.4rem;
  }
  .chip {
    font-family: var(--cit-font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--cit-border);
    background: transparent;
    color: var(--cit-text-secondary);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .chip:hover,
  .chip.is-active {
    border-color: var(--cit-accent-teal);
    color: var(--cit-accent-teal);
  }
  .chip.is-active {
    background: rgba(57, 222, 201, 0.08);
  }
  .featured {
    max-width: 780px;
    margin-bottom: 2rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: 1.25rem;
  }
  .empty {
    border: 1px dashed var(--cit-border);
    border-radius: var(--cit-radius);
    padding: 2rem;
    color: var(--cit-text-muted);
  }
  .feed-note {
    font-family: var(--cit-font-mono);
    font-size: 0.72rem;
    color: var(--cit-text-muted);
    margin: 2.5rem 0 3rem;
  }
  @media (max-width: 640px) {
    .head-actions .btn {
      width: 100%;
    }
  }
</style>
