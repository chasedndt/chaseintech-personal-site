---
import Layout from "../layouts/Layout.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { site, newsletter } from "../data/site.js";
---

<Layout
  title={`${newsletter.name} — ${site.brand}`}
  description={newsletter.description}
>
  <div class="container page">
    <header class="page-head">
      <p class="section-label">ChaseInTech Dispatch</p>
      <h1>AI developments, tested—not repeated</h1>
      <p class="intro">
        Timely AI news, technical analysis, independent model studies, and the
        engineering decisions behind the systems I build.
      </p>
    </header>

    <section class="topics" aria-labelledby="topics-heading">
      <h2 id="topics-heading">What lands in your inbox</h2>
      <ul>
        <li>
          <strong>AI news and analysis</strong>
          <span>What changed, what the source actually supports, and why it matters.</span>
        </li>
        <li>
          <strong>Independent studies</strong>
          <span>Model claims, workflow tests, trust boundaries, and evidence.</span>
        </li>
        <li>
          <strong>Technical deep dives</strong>
          <span>Architecture, agent governance, performance, and product decisions.</span>
        </li>
        <li>
          <strong>Build notes</strong>
          <span>Practical lessons from ChaseOS and the wider ChaseInTech portfolio.</span>
        </li>
      </ul>
    </section>

    <NewsletterSignup heading="Join ChaseInTech Dispatch" />

    <p class="rss-option">
      Prefer a feed reader? The full-content articles feed remains available at
      <a class="text-link" href="/rss.xml">/rss.xml</a>.
    </p>
  </div>
</Layout>

<style>
  .page {
    max-width: 960px;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  .page-head {
    max-width: 760px;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3.3rem);
    margin-top: 0.6rem;
  }
  .intro {
    color: var(--cit-text-secondary);
    font-size: 1.08rem;
    max-width: 65ch;
    margin-top: 1rem;
  }
  .topics {
    margin: 3rem 0;
  }
  .topics h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .topics ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0;
    padding: 0;
  }
  .topics li {
    display: grid;
    gap: 0.35rem;
    border: 1px solid var(--cit-border);
    border-radius: var(--cit-radius);
    background: var(--cit-bg-surface);
    padding: 1.15rem;
  }
  .topics strong {
    color: var(--cit-text-primary);
  }
  .topics span {
    color: var(--cit-text-secondary);
    font-size: 0.9rem;
  }
  .rss-option {
    margin-top: 1.4rem;
    color: var(--cit-text-muted);
    font-size: 0.85rem;
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 3rem;
    }
    .topics ul {
      grid-template-columns: 1fr;
    }
  }
</style>
